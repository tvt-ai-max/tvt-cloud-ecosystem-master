# ============================================================
# TVT Cloud Ecosystem — Biến môi trường Production
# Sao chép file này thành .env.production và điền giá trị thực
# cp .env.production.example .env.production
# ============================================================

# --- Cấu hình chung (General) ---
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh

# --- Redis (dùng chung cho Concierge & Review) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Scanner Service (Port 3000) ---
# API key bảo mật cho Scanner endpoint
SCANNER_API_KEY=your_scanner_api_key_here
# Thư mục lưu PDF output
SCANNER_PDF_DIR=/app/pdfs
# Timeout (ms) cho mỗi lần scan
SCANNER_TIMEOUT=60000

# --- Billing Service (Port 3001) ---
# VietQR webhook secret để xác thực callback
VIETQR_WEBHOOK_SECRET=your_vietqr_webhook_secret_here
# Thông tin tài khoản ngân hàng nhận tiền
BANK_ACCOUNT_NO=your_bank_account_number
BANK_BIN=your_bank_bin_code
# API key dịch vụ thanh toán
BILLING_API_KEY=your_billing_api_key_here

# --- Concierge Service (Port 3002) ---
# OpenAI API key cho AI Concierge RAG
OPENAI_API_KEY=your_openai_api_key_here
# Model AI sử dụng
OPENAI_MODEL=gpt-4o-mini
# Số lượng kết quả RAG tối đa
RAG_TOP_K=5
# API key bảo mật cho Concierge endpoint
CONCIERGE_API_KEY=your_concierge_api_key_here

# --- Review Booster Service (Port 3003) ---
# Google Places API key cho review management
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# Google Place ID của doanh nghiệp
GOOGLE_PLACE_ID=your_google_place_id_here
# API key bảo mật cho Review endpoint
REVIEW_API_KEY=your_review_api_key_here

# --- Domain & Server ---
API_DOMAIN=api.tvtagency.com
VPS_IP=187.77.157.54
